DEMAND_DB_PASSWORD=muda_esta_password
REVENUE_DB_PASSWORD=muda_esta_password
PAYMENT_DB_PASSWORD=muda_esta_password

# Só para o deploy no GKE (Grafana)
GRAFANA_ADMIN_PASSWORD=muda_esta_password
