# Copiar para .env (cp .env.example .env) e definir as passwords.
# O .env está no .gitignore e nunca deve ser commitado.
# Usado pelo docker-compose dos serviços, pelos seed.py e pelo kubernetesCloud/create-secrets.sh.

LOCATION_DB_PASSWORD=muda_esta_password
